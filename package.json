{
  "name": "stagemask",
  "version": "0.1.0",
  "description": "Visual regression testing tool for Playwright with interactive mask editing - draw masks over dynamic content with a visual UI",
  "keywords": [
    "playwright",
    "visual-regression",
    "visual-testing",
    "screenshot",
    "screenshot-testing",
    "testing",
    "mask",
    "stagemask",
    "e2e",
    "end-to-end",
    "ui-testing",
    "applitools-alternative",
    "percy-alternative"
  ],
  "author": "Irfan Mujagic",
  "license": "MIT",
  "homepage": "https://github.com/Crypted39/stagemask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crypted39/stagemask.git"
  },
  "bugs": {
    "url": "https://github.com/Crypted39/stagemask/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "stagemask": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./fixture": {
      "types": "./dist/plugin/fixture.d.ts",
      "import": "./dist/plugin/fixture.mjs",
      "require": "./dist/plugin/fixture.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && npm run build:ui",
    "build:ui": "vite build",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "express": "5.2.1",
    "glob": "13.0.1",
    "open": "11.0.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.1",
    "@types/express": "5.0.6",
    "@types/node": "25.2.0",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.3.0",
    "jiti": "2.6.1",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0 <2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
